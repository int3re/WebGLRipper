{
	"manifest_version": 3,
	"name": "WebGL Ripper",
	"description": "Rip 3D models (OBJ/MTL) and textures (PNG) from WebGL pages.",
	"author": "Rilshrink",
	"version": "1.1.1",
	"minimum_chrome_version": "121",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "WebGL Ripper",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"scripts": ["background.js"]
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["webglripper.js", "viewer.js"],
			"run_at": "document_start",
			"all_frames": true,
			"match_about_blank": true,
			"world": "MAIN"
		},
		{
			"matches": ["<all_urls>"],
			"js": ["settings.js", "bridge.js"],
			"run_at": "document_start",
			"all_frames": true,
			"match_about_blank": true
		}
	],
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"commands": {
		"capture-frame": {
			"description": "Rip the next frame in the current tab"
		},
		"pick-object": {
			"description": "Pick one object in the current tab and rip it"
		}
	},
	"permissions": [
		"storage"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "rilshrink@webglripper",
			"strict_min_version": "128.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}
