{
	"manifest_version": 3,
	"name": "__MSG_extensionName__",
	"description": "__MSG_extensionDescription__",
	"default_locale": "en",
	"author": "Rilshrink",
	"version": "1.3.2",
	"minimum_chrome_version": "121",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "WebGL Ripper",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"scripts": ["background.js"]
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["webglripper.js", "viewer.js"],
			"run_at": "document_start",
			"all_frames": true,
			"match_about_blank": true,
			"world": "MAIN"
		},
		{
			"matches": ["<all_urls>"],
			"js": ["settings.js", "i18n.js", "bridge.js"],
			"run_at": "document_start",
			"all_frames": true,
			"match_about_blank": true
		}
	],
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"commands": {
		"capture-frame": {
			"description": "__MSG_commandCapture__"
		},
		"pick-object": {
			"description": "__MSG_commandPick__"
		}
	},
	"permissions": [
		"storage"
	],
	"optional_permissions": [
		"downloads",
		"downloads.open"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "rilshrink@webglripper",
			"strict_min_version": "128.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}
